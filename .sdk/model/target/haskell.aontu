
main: kit: target: haskell: {

  title: Haskell
  ext: hs
  comment: line: "--"
  module: name: '$$name$$'
  base: 'BASE'
  srcfeature: false

  # Entities are generic (config-driven F.makeEntity): the entity phase runs,
  # as it does for every SDK, and its component writes no module; no
  # per-feature module is generated.
  phase: {
    feature:    { active: false }
    readme:     { active: true }
    agentguide: { active: true }
    test:       { active: true }
  }

  deps: &: {
    kind: *'prod' | string
  }

  deps: {}
}


main: kit: feature: &: target: haskell: deps: &: {
  kind: *'prod' | string
}


main: kit: target: haskell: publish: {
  registry: {
    name: 'hackage'
    url: 'https://hackage.haskell.org'
    vault: { alias: 'hackage', env: 'HACKAGE_TOKEN' }
  }
}


main: kit: target: haskell: feature: {
  trim: false
}
