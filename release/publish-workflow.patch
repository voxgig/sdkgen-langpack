@@ -0,0 +1,355 @@
+# Releases @voxgig/sdkgen-langpack: verifies, publishes to npm, then writes the git tag.
+#
+# ONE FILE, BECAUSE NPM ALLOWS EXACTLY ONE. A trusted publisher is registered
+# on npmjs.com against a single workflow FILENAME, so anything that must
+# accompany a publish has to live inside it. Here that is the verification and
+# the tag.
+#
+# THREE JOBS, BECAUSE THEY NEED DIFFERENT PRIVILEGES. Each holds the least it
+# can, and no job holds a credential while running code it did not write.
+#
+#   verify   contents: read, and NOTHING else. Runs npm install, the build,
+#            the tests and the package gate -- i.e. dependency lifecycle
+#            scripts and project code. It has no publish credential to steal
+#            and no repository write.
+#   publish  id-token: write, contents: read. Installs NO project
+#            dependencies and runs NO project code: this package ships pure
+#            source (`files` is .sdk + the manifest, and the build is
+#            `noEmit`), so nothing needs building to pack.
+#   tag      contents: write. Runs git and nothing else.
+#
+# THE SPLIT IS THE POINT. A compromised dependency lifecycle script can ask
+# the runner for any OIDC token the JOB is permitted to mint -- so a job that
+# both installs dependencies and holds `id-token: write` can be made to
+# publish as this package before its own gates finish. Keeping the install in
+# a job with no id-token, and the credential in a job that installs nothing,
+# is what makes the isolation real rather than nominal. The same reasoning
+# keeps `contents: write` out of both: checkout persists its token into the
+# git config for the whole job.
+#
+# A ref pushed with GITHUB_TOKEN does NOT start another workflow run, so the
+# tag job cannot be replaced by "tag and let the publisher fire on it".
+#
+# TWO WAYS IN, AND BOTH MUST COME FROM main:
+#
+#   workflow_dispatch  the normal path. Publishes what is missing, then tags.
+#   push: tags v*      the manual path, for a tag pushed by hand. Publishes
+#                      only; the tag job does not run.
+#
+# A tag can be pushed from ANY commit, so the tag path is not self-limiting:
+# without the containment check below, pushing a matching v* tag from an
+# unmerged branch would publish unreviewed code irreversibly.
+#
+# VERSION BUMPS ARE NOT AUTOMATED, deliberately. Nothing here commits. It
+# reads the version already on the branch and releases exactly that, so the
+# bump stays a reviewable diff and the release stays a button.
+#
+#   package.json "version"  ->  tag v<version>
+#
+# package.json and sdkgen-package.json BOTH carry a version and both ship.
+# Nothing else compares them -- `package check` does not -- so this does.
+#
+# This repo commits NO lockfile, so the install is `npm install`, not `npm ci`.
+#
+# Renaming this file breaks publishing until the npm-side trusted publisher is
+# updated to match.
+
+name: publish
+
+on:
+  push:
+    tags: ['v*']
+  workflow_dispatch:
+    inputs:
+      expect_sha:
+        description: 'Optional: refuse unless main is still at this commit'
+        type: string
+        default: ''
+
+env:
+  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: true
+
+jobs:
+  verify:
+    name: verify
+    runs-on: ubuntu-latest
+    timeout-minutes: 20
+
+    # Deliberately the default-minimum. This job runs third-party code.
+    permissions:
+      contents: read
+
+    outputs:
+      version: ${{ steps.versions.outputs.version }}
+
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
+        with:
+          fetch-depth: 0
+
+      - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7
+        with:
+          node-version: 24.x
+
+      - name: Resolve the version, and check both manifests agree
+        id: versions
+        run: |
+          set -euo pipefail
+          VERSION="$(node -p "require('./package.json').version")"
+          SDKVER="$(node -p "require('./sdkgen-package.json').version")"
+          test -n "$VERSION" || { echo "::error::could not read package.json version"; exit 1; }
+
+          # Both files ship, and a release bumping only one leaves consumers
+          # with conflicting metadata. No other gate compares them.
+          if [ "$VERSION" != "$SDKVER" ]; then
+            echo "::error::package.json is $VERSION but sdkgen-package.json is $SDKVER -- bump both"
+            exit 1
+          fi
+
+          echo "version=$VERSION" >> "$GITHUB_OUTPUT"
+          echo "$VERSION -> tag v$VERSION"
+
+      # RELEASES COME FROM main, INCLUDING FROM THE BUTTON. `workflow_dispatch`
+      # accepts any branch or tag, so without this the Actions UI could
+      # publish and tag a feature branch, irreversibly.
+      - name: Dispatches must come from main
+        if: ${{ github.event_name == 'workflow_dispatch' }}
+        run: |
+          set -euo pipefail
+          if [ "$GITHUB_REF_NAME" != "main" ]; then
+            echo "::error::dispatch ref is $GITHUB_REF_NAME; releases must come from main"
+            exit 1
+          fi
+
+      # ...AND SO DOES THE TAG PATH. A tag names any commit its pusher likes,
+      # so matching package.json is not enough: an unmerged commit carrying a
+      # bumped version would otherwise publish. Containment is the invariant,
+      # checked the same way for both entry points.
+      - name: The released commit must be on main
+        run: |
+          set -euo pipefail
+          git fetch --no-tags --depth=0 origin main
+          if ! git merge-base --is-ancestor "$GITHUB_SHA" origin/main; then
+            echo "::error::$GITHUB_SHA is not contained in origin/main; refusing to release it"
+            exit 1
+          fi
+          echo "$GITHUB_SHA is on main"
+
+      # main is a MUTABLE branch: between deciding to release and this run
+      # resolving, another commit can land and be released under the version
+      # just approved.
+      - name: main must still be the commit we intended to release
+        if: ${{ github.event_name == 'workflow_dispatch' && inputs.expect_sha != '' }}
+        env:
+          EXPECT_SHA: ${{ inputs.expect_sha }}
+        run: |
+          set -euo pipefail
+          if [ "$GITHUB_SHA" != "$EXPECT_SHA" ]; then
+            echo "::error::main has moved: expected $EXPECT_SHA, got $GITHUB_SHA"
+            exit 1
+          fi
+
+      # A tag pushed by hand must agree with the version it claims to release.
+      # Without this, pushing v1.2.0 while package.json still says 1.1.0
+      # resolves 1.1.0, finds it already published, skips the publish, and the
+      # run goes GREEN -- leaving a v1.2.0 tag with no npm release behind it.
+      - name: The pushed tag must match the package version
+        if: ${{ github.event_name == 'push' }}
+        env:
+          VERSION: ${{ steps.versions.outputs.version }}
+        run: |
+          set -euo pipefail
+          WANT="v$VERSION"
+          if [ "$GITHUB_REF_NAME" != "$WANT" ]; then
+            echo "::error::tag $GITHUB_REF_NAME does not match package.json ($WANT)"
+            exit 1
+          fi
+
+      # AN EXISTING TAG IS ONLY A PROBLEM IF IT POINTS SOMEWHERE ELSE. A tag
+      # already on THIS commit is the idempotent case: it is what makes
+      # re-dispatching after a partial release safe. A tag on a different
+      # commit means the version was not bumped.
+      - name: Refuse a tag that points at a different commit
+        if: ${{ github.event_name == 'workflow_dispatch' }}
+        env:
+          VERSION: ${{ steps.versions.outputs.version }}
+        run: |
+          set -euo pipefail
+          TAG="v$VERSION"
+          HEAD_SHA="$(git rev-parse HEAD)"
+          AT="$(git rev-parse -q --verify "refs/tags/$TAG^{commit}" 2>/dev/null || true)"
+          if [ -n "$AT" ] && [ "$AT" != "$HEAD_SHA" ]; then
+            echo "::error::tag $TAG already exists on $AT, not this commit -- bump the version"
+            exit 1
+          fi
+          if [ -n "$AT" ]; then
+            echo "$TAG already points here; nothing to create"
+          fi
+
+      - name: Install, build and test
+        run: |
+          npm install --no-audit --no-fund
+          npm run build
+          npm test
+
+      # This repo IS an sdkgen package, so its own authoring gate is a
+      # release gate.
+      - name: Check the package manifest
+        run: npm run check-package
+
+  publish:
+    name: npm publish
+    needs: verify
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+
+    # The ONLY job holding the publish credential -- and it installs no
+    # project dependencies and runs no project code. See the header.
+    permissions:
+      id-token: write
+      contents: read
+
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
+
+      - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7
+        with:
+          node-version: 24.x
+          registry-url: 'https://registry.npmjs.org'
+
+      # Trusted publishing requires npm >= 11.5.1. This is npm itself, not a
+      # project dependency: no package.json here is consulted.
+      - name: Use a trusted-publishing capable npm
+        run: npm install -g npm@latest
+
+      # THE REGISTRY IS THE SOURCE OF TRUTH FOR "IS THIS RELEASED", not the
+      # tag. A run can publish and then fail before tagging, leaving a version
+      # on npm with nothing pointing at it. Without this check that state is
+      # unrecoverable.
+      - name: Is this version already on npm?
+        id: registry
+        env:
+          VERSION: ${{ needs.verify.outputs.version }}
+        run: |
+          set -euo pipefail
+          if npm view "@voxgig/sdkgen-langpack@$VERSION" version >/dev/null 2>&1; then
+            echo "published=true" >> "$GITHUB_OUTPUT"
+            echo "$VERSION is already on npm -- skipping publish"
+          else
+            echo "published=false" >> "$GITHUB_OUTPUT"
+            echo "$VERSION is not on npm -- will publish"
+          fi
+
+      # SKIPPING THE PUBLISH ASSUMES "SAME VERSION MEANS SAME CODE". That
+      # holds only if main has not moved. npm records the source commit as
+      # `gitHead`, so this is checkable. Absent gitHead cannot be verified, so
+      # warn rather than block: refusing would make legitimate recovery
+      # impossible.
+      - name: A published version must come from this commit
+        if: ${{ steps.registry.outputs.published == 'true' }}
+        env:
+          VERSION: ${{ needs.verify.outputs.version }}
+        run: |
+          set -euo pipefail
+          GH="$(npm view "@voxgig/sdkgen-langpack@$VERSION" gitHead 2>/dev/null || true)"
+          if [ -z "$GH" ]; then
+            echo "::warning::npm records no gitHead for $VERSION; cannot verify it was built from this commit"
+          elif [ "$GH" != "$GITHUB_SHA" ]; then
+            echo "::error::npm has $VERSION built from $GH, but this run is $GITHUB_SHA -- tagging would point at code the registry does not contain"
+            exit 1
+          else
+            echo "$VERSION on npm was built from this commit"
+          fi
+
+      # CHOOSING THE DIST-TAG IS NOT "STABLE MEANS latest".
+      #
+      # A prerelease must never become `latest`: `npm publish` defaults there,
+      # so 1.2.3-beta.1 published that way reaches every unpinned install.
+      #
+      # Nor may an OLDER stable take it. Publishing a historical tag, or two
+      # dispatches finishing out of order, would otherwise move `latest`
+      # BACKWARD and hand unpinned installs the older release. So a stable
+      # version claims `latest` only if it is the newest stable there is.
+      - name: Choose the dist-tag
+        id: disttag
+        if: ${{ steps.registry.outputs.published == 'false' }}
+        env:
+          VERSION: ${{ needs.verify.outputs.version }}
+        run: |
+          set -euo pipefail
+          case "$VERSION" in
+            *-*)
+              DIST=next
+              echo "$VERSION is a prerelease -> $DIST"
+              ;;
+            *)
+              CURRENT="$(npm view "@voxgig/sdkgen-langpack@latest" version 2>/dev/null || true)"
+              if [ -z "$CURRENT" ]; then
+                DIST=latest
+                echo "no current latest -> $DIST"
+              elif [ "$(printf '%s\n%s\n' "$CURRENT" "$VERSION" | sort -V | tail -1)" = "$VERSION" ]; then
+                DIST=latest
+                echo "$VERSION >= current latest $CURRENT -> $DIST"
+              else
+                DIST=previous
+                echo "$VERSION is older than current latest $CURRENT -> $DIST (latest is left alone)"
+              fi
+              ;;
+          esac
+          echo "dist=$DIST" >> "$GITHUB_OUTPUT"
+
+      # Publish BEFORE tagging (the tag job `needs` this one), so a tag only
+      # ever exists for a release that reached the registry.
+      #
+      # `--access public` is required: this is a SCOPED package, and npm
+      # defaults a scoped package to restricted on its FIRST publish.
+      - name: Publish to npm
+        if: ${{ steps.registry.outputs.published == 'false' }}
+        env:
+          VERSION: ${{ needs.verify.outputs.version }}
+          DIST: ${{ steps.disttag.outputs.dist }}
+        run: |
+          set -euo pipefail
+          echo "publishing $VERSION under dist-tag $DIST"
+          npm publish --access public --tag "$DIST"
+
+  # Runs git and nothing else. No install, no project code -- so the
+  # repository-write credential is never in scope while third-party code runs.
+  tag:
+    name: tag
+    needs: [verify, publish]
+    if: ${{ github.event_name == 'workflow_dispatch' }}
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+
+    permissions:
+      contents: write
+
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
+        with:
+          fetch-depth: 0
+
+      - name: Tag the release
+        env:
+          VERSION: ${{ needs.verify.outputs.version }}
+        run: |
+          set -euo pipefail
+          TAG="v$VERSION"
+          HEAD_SHA="$(git rev-parse HEAD)"
+
+          # EXISTENCE IS NOT ENOUGH. `--verify` only asks whether the name
+          # resolves; a tag created between the verify job's guard and this
+          # checkout could point anywhere.
+          AT="$(git rev-parse -q --verify "refs/tags/$TAG^{commit}" 2>/dev/null || true)"
+          if [ -n "$AT" ]; then
+            if [ "$AT" != "$HEAD_SHA" ]; then
+              echo "::error::$TAG exists on $AT, not this commit ($HEAD_SHA)"
+              exit 1
+            fi
+            echo "$TAG already points here -- nothing to do" >> "$GITHUB_STEP_SUMMARY"
+            exit 0
+          fi
+          git tag "$TAG"
+          git push origin "refs/tags/$TAG"
+          echo "pushed $TAG" >> "$GITHUB_STEP_SUMMARY"
